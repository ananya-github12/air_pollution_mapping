# Data source for the app: "mock" (sample data, default) or "live" (snapshots from `npm run fetch-data`)
VITE_DATA_MODE=mock

# Keys used only by `npm run fetch-data` (they never reach the browser). Never commit .env.
# NASA FIRMS fire detections: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAQ (measured CPCB station data): https://explore.openaq.org/register
OPENAQ_API_KEY=
# data.gov.in (CPCB real-time AQI) — optional, not used yet: https://www.data.gov.in
DATA_GOV_IN_API_KEY=
